{
  "name": "rosarium",
  "version": "1.0.0",
  "private": true,
  "description": "Den Rosenkranz beten – Deutsch, English, Latina",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android",
    "icons": "capacitor-assets generate --ios --android --iconBackgroundColor '#2A4896' --iconBackgroundColorDark '#2A4896' --splashBackgroundColor '#ECEFF4' --splashBackgroundColorDark '#0D1221'"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
